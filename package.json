{
  "name": "agenda",
  "productName": "Agenda",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "本地桌面应用：让 Claude Code、Codex、DeepSeek、Gemini 等 AI 在同一个空间里自由讨论、共同编辑文档",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "mock": "electron . --mock",
    "build:launcher": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-launcher.ps1",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "^45.3.0"
  }
}
